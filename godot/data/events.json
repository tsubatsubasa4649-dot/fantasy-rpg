{
  "schema_version": 1,
  "events": [
    {
      "id": "help_village",
      "when": {
        "all": [
          {
            "flag_is": [
              "patrol_started",
              true
            ]
          },
          {
            "flag_is": [
              "patrol_flowers_checked",
              true
            ]
          },
          {
            "flag_is": [
              "patrol_well_checked",
              true
            ]
          },
          {
            "not": {
              "flag_is": [
                "village_helped",
                true
              ]
            }
          }
        ]
      },
      "effects": [
        {
          "set_flag": [
            "village_helped",
            true
          ]
        }
      ],
      "time_cost": 0
    },
