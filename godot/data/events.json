{
  "schema_version": 1,
  "events": [
    {
      "id": "help_village",
      "when": {
        "flag_is": [
          "village_helped",
          false
        ]
      },
      "effects": [
        {
          "set_flag": [
            "village_helped",
            true
          ]
        }
      ],
      "time_cost": 0
    },
    {
      "id": "find_forest_clue",
      "when": {
        "phase_is": 1
      },
      "effects": [
        {
          "set_flag": [
            "forest_clue",
            true
          ]
        }
      ],
      "time_cost": 0
    },
    {
      "id": "save_refugees",
      "when": {
        "phase_gte": 2
      },
      "effects": [
        {
          "set_flag": [
            "refugees_saved",
            true
          ]
        }
      ],
      "time_cost": 0
    },
    {
      "id": "recruit_ricky",
      "when": {
        "all": [
          {
            "phase_lte": 2
          },
          {
            "flag_is": [
              "village_helped",
              true
            ]
          },
          {
            "not": {
              "recruited": "ch_ricky"
            }
          }
        ]
      },
      "effects": [
        {
          "recruit": "ch_ricky"
        }
      ],
      "time_cost": 0
    },
    {
      "id": "recruit_meri",
      "when": {
        "all": [
          {
            "phase_is": 1
          },
          {
            "flag_is": [
              "forest_clue",
              true
            ]
          },
          {
            "not": {
              "recruited": "ch_meri"
            }
          }
        ]
      },
      "effects": [
        {
          "recruit": "ch_meri"
        }
      ],
      "time_cost": 0
    },
    {
      "id": "recruit_goro",
      "when": {
        "all": [
          {
            "phase_gte": 2
          },
          {
            "flag_is": [
              "refugees_saved",
              true
            ]
          },
          {
            "not": {
              "recruited": "ch_goro"
            }
          }
        ]
      },
      "effects": [
        {
          "recruit": "ch_goro"
        }
      ],
      "time_cost": 0
    },
    {
      "id": "bridge_investigate",
      "when": {
        "all": [
          {
            "recruited": "ch_ricky"
          },
          {
            "recruited": "ch_meri"
          },
          {
            "phase_gte": 2
          }
        ]
      },
      "effects": [
        {
          "set_storyline_stage": [
            "bridge",
            "start"
          ]
        },
        {
          "set_flag": [
            "bridge_evidence",
            true
          ]
        }
      ],
      "time_cost": 0
    },
    {
      "id": "bridge_resolution",
      "when": {
        "all": [
          {
            "storyline_stage_is": [
              "bridge",
              "start"
            ]
          },
          {
            "active": "ch_meri"
          },
          {
            "flag_is": [
              "bridge_evidence",
              true
            ]
          }
        ]
      },
      "effects": [
        {
          "set_storyline_stage": [
            "bridge",
            "resolution"
          ]
        },
        {
          "set_flag": [
            "bridge_reconciled",
            true
          ]
        }
      ],
      "time_cost": 0
    },
    {
      "id": "defeat_darklord",
      "when": {
        "phase_gte": 3
      },
      "effects": [
        {
          "set_flag": [
            "darklord_defeated",
            true
          ]
        }
      ],
      "time_cost": 0
    },
    {
      "id": "rest_at_inn",
      "when": {
        "always": true
      },
      "effects": [],
      "time_cost": "rest"
    },
    {
      "id": "travel_region",
      "when": {
        "always": true
      },
      "effects": [],
      "time_cost": "region_travel"
    },
    {
      "id": "major_story_advance",
      "when": {
        "always": true
      },
      "effects": [],
      "time_cost": "major_event"
    },
    {
      "id": "extended_expedition",
      "when": {
        "always": true
      },
      "effects": [],
      "time_cost": 10
    },
    {
      "id": "read_village_sign",
      "when": {
        "flag_is": [
          "windle_sign_read",
          false
        ]
      },
      "effects": [
        {
          "set_flag": [
            "windle_sign_read",
            true
          ]
        }
      ],
      "time_cost": 0
    },
    {
      "id": "discover_well_emblem",
      "when": {
        "flag_is": [
          "windle_well_discovered",
          false
        ]
      },
      "effects": [
        {
          "set_flag": [
            "windle_well_discovered",
            true
          ]
        }
      ],
      "time_cost": 0
    }
  ]
}
